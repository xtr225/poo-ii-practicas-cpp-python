@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F2F4F7
skinparam classBorderColor #0057FF
skinparam ArrowColor #0057FF
hide empty members
class Huesped {
  -__id: str
  +nombre: Any
  +documento: Any
  -__nombre: str
  -__documento: str
  +__init__(identificador: Any, nombre: Any, documento: Any): Any
  +id(): Any
  +nombre(): Any
  +nombre(valor: Any): Any
  +documento(): Any
  +documento(valor: Any): Any
  +etiqueta(): Any
  +actualizar_documento(documento: Any): Any
}
class Habitacion {
  -__numero: int
  -__ocupantes: int
  +tipo: Any
  +capacidad: Any
  +tarifa: Any
  -__tipo: str
  -__capacidad: int
  -__tarifa: float
  +__init__(numero: Any, tipo: Any, capacidad: Any, tarifa: Any): Any
  +numero(): Any
  +tipo(): Any
  +tipo(valor: Any): Any
  +capacidad(): Any
  +capacidad(valor: Any): Any
  +tarifa(): Any
  +tarifa(valor: Any): Any
  +plazas_libres(): Any
  +alojar(cantidad: Any): Any
  +liberar(): Any
  +precio_noche(): Any
}
class Reserva {
  -__codigo: str
  -__entrada: date
  -__salida: date
  -__estado: str
  +__init__(codigo: Any, entrada: Any, salida: Any): Any
  +codigo(): Any
  +entrada(): Any
  +salida(): Any
  +noches(): Any
  +estado(): Any
  +confirmar(): Any
  +anular(): Any
}
class HabitacionSimple {
  +__init__(numero: Any, tarifa: Any): Any
  +precio_noche(): Any
}
class HabitacionDoble {
  +__init__(numero: Any, tarifa: Any): Any
  +precio_noche(): Any
}
class Suite {
  +__init__(numero: Any, tarifa: Any): Any
  +precio_noche(): Any
}
class INotificador <<abstract>> {
  +enviar(destinatario: Any, mensaje: Any): Any
  +es_disponible(): Any
  +nombre(): Any
}
class ProtocolNotificador {
  +enviar(destinatario: str, mensaje: str): bool
  +es_disponible(): bool
}
class CanalSimulado {
  #_servidor: Any
  +activo: Any
  +enviados: Any
  +__init__(servidor: Any): Any
  +es_disponible(): Any
  +enviar(destinatario: Any, mensaje: Any): Any
}
class NotificadorEmail {
  #_canal: Any
  +__init__(servidor: Any): Any
  +nombre(): Any
  +enviados(): Any
  +activo(): Any
  +activo(valor: Any): Any
  +es_disponible(): Any
  +enviar(destinatario: Any, mensaje: Any): Any
}
class NotificadorSMS {
  #_canal: Any
  +__init__(proveedor: Any): Any
  +nombre(): Any
  +es_disponible(): Any
  +enviar(destinatario: Any, mensaje: Any): Any
}
class SistemaAlertas {
  #_notificadores: Any
  +errores: Any
  +__init__(notificadores: Any): Any
  +agregar_notificador(notificador: Any): Any
  +alertar(dest: Any, mensaje: Any): Any
}
class Exportador <<abstract>> {
  +extension(): Any
  +exportar(contenido: Any, ruta: Any): Any
}
class ExportadorCSV {
  +extension(): Any
  +exportar(contenido: Any, ruta: Any): Any
}
class ExportadorJSON {
  +extension(): Any
  +exportar(contenido: Any, ruta: Any): Any
}
class Firmador <<abstract>> {
  +firmar(ruta: Any): Any
}
class FirmadorDigital {
  +firmar(ruta: Any): Any
}
class GeneradorReporte {
  #_exportador: Any
  #_firmador: Any
  +__init__(exportador: Any, firmador: Any): Any
  +cambiar_exportador(exportador: Any): Any
  +generar(datos: Any, ruta: Any): Any
}
class CalculadoraTarifa <<abstract>> {
  +calcular(habitacion: Any, noches: Any): Any
  +descripcion(): Any
}
class TarifaEstandar {
  +calcular(habitacion: Any, noches: Any): Any
  +descripcion(): Any
}
class ServicioCotizacion {
  #_calculadora: Any
  +__init__(calculadora: Any): Any
  +cotizar(habitacion: Any, noches: Any): Any
}
Habitacion <|-- HabitacionSimple
Habitacion <|-- HabitacionDoble
Habitacion <|-- Suite
INotificador <|.. NotificadorEmail
INotificador <|.. NotificadorSMS
Exportador <|.. ExportadorCSV
Exportador <|.. ExportadorJSON
Firmador <|.. FirmadorDigital
CalculadoraTarifa <|.. TarifaEstandar
NotificadorEmail "1" *-- "1" CanalSimulado : canal propio
NotificadorSMS "1" *-- "1" CanalSimulado : canal propio
GeneradorReporte "1" --> "1" Exportador : dependencia recibida
GeneradorReporte "1" --> "0..1" Firmador : firma opcional
ServicioCotizacion "1" --> "1" CalculadoraTarifa : calculo recibido
legend bottom
Modelo elaborado con asistencia a partir de fuentes y decisiones de dominio.
Any indica que la firma Python no declara ese tipo; el contrato se detalla en el código y en C++.
Composición representa vida dependiente; las referencias compartidas conservan vida independiente.
endlegend
@enduml
